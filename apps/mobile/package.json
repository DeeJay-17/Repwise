{
  "name": "repwise-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~58.0.25",
    "better-sqlite3": "^13.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "api:generate": "npx --yes openapi-typescript@7 ../../packages/contracts/openapi/ai-service.json -o src/api/ai-service.generated.ts && npx --yes openapi-typescript@7 ../../packages/contracts/openapi/core-api.json -o src/api/core-api.generated.ts && prettier --write src/api/*.generated.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
