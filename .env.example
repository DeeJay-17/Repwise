# Copy to .env at the repo root for `docker compose` (infra/docker-compose.yml).
# Never commit the real .env.

POSTGRES_USER=repwise
POSTGRES_PASSWORD=change-me
POSTGRES_DB=repwise

# core-api
CORE_API_DATABASE_URL=postgresql+psycopg://repwise:change-me@db:5432/repwise
CORE_API_LOG_LEVEL=INFO

# ai-service (no provider keys here: users send their own key per request)
AI_SERVICE_LOG_LEVEL=INFO
