{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repwise.app/schemas/plan/1.0.json",
  "title": "Repwise workout plan",
  "description": "A weekly workout plan. The single definition shared by the mobile app, core-api and ai-service.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "source", "goal", "daysPerWeek", "sessionMinutes", "focusMuscles", "days", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "source": {
      "description": "ai = generated by a model; fallback = rule-based template after AI failure; manual = built by the user.",
      "enum": ["ai", "fallback", "manual"]
    },
    "goal": { "$ref": "#/$defs/goal" },
    "daysPerWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
    "sessionMinutes": { "type": "integer", "minimum": 10, "maximum": 180 },
    "focusMuscles": {
      "description": "Muscle groups the user asked to emphasise when regenerating. Empty for a balanced plan.",
      "type": "array",
      "items": { "$ref": "#/$defs/muscleGroup" },
      "uniqueItems": true
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/day" }
    },
    "notes": { "type": "string", "maxLength": 1000 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "goal": {
      "enum": ["fat_loss", "muscle_gain", "strength", "general_fitness", "endurance"]
    },
    "muscleGroup": {
      "enum": ["chest", "back", "shoulders", "biceps", "triceps", "forearms", "core", "glutes", "quadriceps", "hamstrings", "calves", "full_body"]
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dayIndex", "name", "exercises"],
      "properties": {
        "dayIndex": { "description": "Position in the week, 1 = first training day.", "type": "integer", "minimum": 1, "maximum": 7 },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": { "$ref": "#/$defs/plannedExercise" }
        }
      }
    },
    "plannedExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseId", "order", "sets", "target", "restSeconds"],
      "properties": {
        "exerciseId": { "description": "ID from the bundled exercise catalogue.", "type": "string", "pattern": "^[a-z0-9_]+$" },
        "order": { "type": "integer", "minimum": 1 },
        "sets": { "type": "integer", "minimum": 1, "maximum": 10 },
        "target": { "oneOf": [{ "$ref": "#/$defs/repTarget" }, { "$ref": "#/$defs/timeTarget" }] },
        "restSeconds": { "type": "integer", "minimum": 0, "maximum": 600 },
        "notes": { "type": "string", "maxLength": 200 }
      }
    },
    "repTarget": {
      "description": "A rep range per set, e.g. 8 to 12.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "minReps", "maxReps"],
      "properties": {
        "kind": { "const": "reps" },
        "minReps": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxReps": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "timeTarget": {
      "description": "A duration per set, for holds and treadmill work.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "seconds"],
      "properties": {
        "kind": { "const": "time" },
        "seconds": { "type": "integer", "minimum": 5, "maximum": 3600 }
      }
    }
  }
}
